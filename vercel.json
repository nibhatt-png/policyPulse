{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api:app",
      "functions": {
        "api.py": {
          "excludeFiles": "{frontend/**,ingest/**,app/**,scripts/**,logs/**,venv/**,.cache/**,**/*.log,test_*.py}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
